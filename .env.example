# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Admin ────────────────────────────────────────────────────────────────────
# Clave para descargar el CSV: GET /api/waitlist/export?key=ADMIN_SECRET
ADMIN_SECRET=change-me-to-something-secure

# Email donde llegan las notificaciones de nuevos signups
ADMIN_EMAIL=tu@email.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Creá una cuenta gratuita en https://resend.com (3.000 emails/mes gratis)
# 1. Verificá tu dominio en Resend > Domains
# 2. Generá un API key en Resend > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# El "from" que verán los usuarios. Debe usar el dominio verificado en Resend.
EMAIL_FROM=Hackr <hola@hackr.app>

# ── Base de datos ────────────────────────────────────────────────────────────
# Railway inyecta esta variable automáticamente cuando agregás el plugin de PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hackr
